<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MountainWeather">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MountainWeather">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.WeatherMinimalReceiver"
            android:exported="true"
            android:label="@string/widget_name_minimal">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_minimal" />
        </receiver>

        <receiver
            android:name=".widget.WeatherDailyReceiver"
            android:exported="true"
            android:label="@string/widget_name_daily">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_daily" />
        </receiver>

        <receiver
            android:name=".widget.WeatherCurrentReceiver"
            android:exported="true"
            android:label="@string/widget_name_current">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_current" />
        </receiver>

        <receiver
            android:name=".widget.WeatherParamsReceiver"
            android:exported="true"
            android:label="@string/widget_name_params">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_params" />
        </receiver>

        <receiver
            android:name=".widget.WeatherHourlyReceiver"
            android:exported="true"
            android:label="@string/widget_name_hourly">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_hourly" />
        </receiver>

        <receiver
            android:name=".widget.WeatherCompactReceiver"
            android:exported="true"
            android:label="@string/widget_name_compact">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_compact" />
        </receiver>

        <receiver
            android:name=".widget.WeatherRainReceiver"
            android:exported="true"
            android:label="@string/widget_name_rain">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_rain" />
        </receiver>

        <receiver
            android:name=".widget.WeatherSunReceiver"
            android:exported="true"
            android:label="@string/widget_name_sun">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_sun" />
        </receiver>

        <activity
            android:name=".widget.config.WidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.MountainWeather">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>
</manifest>
