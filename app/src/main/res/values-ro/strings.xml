    <!-- Widgets -->
    <string name="widget_name_minimal">Carusel favorite</string>
    <string name="widget_description_minimal">Vizualizare compactă 1×1; atinge pentru a schimba favoritele. Mai lat: orașul anterior, curent și următor unul lângă altul.</string>
    <string name="widget_name_daily">Prognoză pe mai multe zile</string>
    <string name="widget_description_daily">Afișează azi și zilele următoare (mai multe când e mai lat). Atinge pentru a derula prognoza. Redimensionabil de la 1×1.</string>
