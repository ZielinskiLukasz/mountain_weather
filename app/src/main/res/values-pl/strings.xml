    <!-- Widgets -->
    <string name="widget_name_minimal">Karuzela ulubionych</string>
    <string name="widget_description_minimal">Kompaktowy widok 1×1; kliknij, aby przełączać ulubione. Szerszy układ: poprzednie, bieżące i następne miasto obok siebie.</string>
    <string name="widget_name_daily">Prognoza wielodniowa</string>
    <string name="widget_description_daily">Pokazuje dziś i kolejne dni (więcej przy szerszym rozmiarze). Kliknij, aby przewijać prognozę. Rozciągalny od 1×1.</string>
    <string name="widget_name_current">Jedno ulubione miasto</string>
    <string name="widget_description_current">Zawsze tylko jedno miasto na ekranie. Kliknij, aby przełączyć na kolejne ulubione.</string>
    <string name="widget_name_params">Miasto i parametry</string>
    <string name="widget_description_params">Jedno miasto; po rozciągnięciu parametry z ustawień po prawej lub na dole. Kliknij, aby zmienić miasto.</string>
    <string name="widget_name_hourly">Prognoza godzinowa</string>
    <string name="widget_description_hourly">Pasek godzinowy (4×1, rozszerzalny do 5×1+): następne godziny dla wybranego miasta. Kliknięcie otwiera aplikację.</string>
    <string name="widget_hourly_disabled">Włącz prognozę godzinową w ustawieniach</string>
    <string name="widget_name_compact">Przypięte miasto</string>
    <string name="widget_description_compact">Skalowalny widget 2×1 / 2×2. Przypnij ulubione miasto albo pozwól mu śledzić główny ekran apki.</string>
    <string name="widget_name_rain">Pasek opadów 24h</string>
    <string name="widget_description_rain">Poziomy widget 3×1 z prognozą opadów na najbliższe 24 godziny. Śledzi lokalizację z głównego ekranu apki.</string>
